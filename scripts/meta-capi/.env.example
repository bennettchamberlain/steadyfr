# Local secrets for scripts/meta-capi/send-conversions.mjs.
# Copy this file to `.env.local` (same folder) and fill in the values.
# `.env.local` is git-ignored — it never gets committed or deployed.

# Notion integration token (starts with ntn_ or secret_).
# Same value as the website's NOTION_TOKEN in Vercel — copy it from
# Vercel → Project → Settings → Environment Variables.
NOTION_TOKEN=

# Meta Conversions API access token (starts with EAA...).
# Generate in Events Manager → your dataset → Settings →
# Conversions API → Generate access token.
META_CAPI_TOKEN=

# Optional overrides — leave blank to use the defaults.
# NOTION_DATABASE_ID=
# META_DATASET_ID=767536079342741
